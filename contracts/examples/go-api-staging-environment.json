{
  "apiVersion": "platform.idp/v1alpha1",
  "kind": "ServiceEnvironment",
  "metadata": {
    "service": "orders-api",
    "owner": "orders-team",
    "environment": "staging",
    "requestId": "f4d26f61-ef7d-4bd9-9568-ae621d91187f"
  },
  "spec": {
    "template": { "id": "go-chi-api", "version": "v0.1.0" },
    "image": {
      "repository": "123456789012.dkr.ecr.eu-west-1.amazonaws.com/orders-api",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "deployment": {
      "port": 8080,
      "health": { "livePath": "/health/live", "readyPath": "/health/ready" },
      "resources": { "cpu": "250m", "memory": "256Mi" },
      "autoscaling": { "minReplicas": 1, "maxReplicas": 3, "targetCPUUtilization": 70 },
      "environment": { "LOG_LEVEL": "info" }
    },
    "database": { "engine": "postgres", "secretRef": "orders-api-db" },
    "dns": { "hostname": "orders-api.staging.example.com" },
    "secrets": [
      { "name": "DATABASE_URL", "remoteKey": "platform/orders-api/staging/database" }
    ]
  }
}
