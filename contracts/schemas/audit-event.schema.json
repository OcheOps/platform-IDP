{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-idp.dev/schemas/audit-event.schema.json",
  "title": "Append-only audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "occurredAt", "actor", "action", "subject", "requestId", "outcome"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "system", "github"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "enum": [
        "request.created", "request.cancelled", "repository.started", "repository.created",
        "repository.failed", "plan.completed", "plan.failed", "approval.granted",
        "approval.revoked", "authorization.denied", "apply.started", "apply.completed",
        "apply.failed", "operation.retried", "deployment.reconciled", "deployment.failed",
        "drift.detected", "preview.created", "preview.extended", "preview.deleted",
        "teardown.requested", "snapshot.completed", "snapshot.failed", "teardown.completed",
        "teardown.failed", "role_mapping.changed", "secret_reference.created",
        "secret_reference.rotated", "secret_reference.deleted"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["service", "environment", "request", "approval", "snapshot", "repository", "role_mapping", "secret_reference"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "requestId": { "type": "string", "format": "uuid" },
    "outcome": { "enum": ["started", "succeeded", "failed", "denied"] },
    "reason": { "type": "string", "maxLength": 1000 },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
    }
  }
}
