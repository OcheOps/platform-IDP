{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-idp.dev/schemas/common.schema.json",
  "title": "Shared platform contract definitions",
  "$defs": {
    "serviceName": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$" },
    "githubTeam": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "enum": ["go-chi-api", "node-nest-api", "java-spring-api", "nextjs-web"] },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "enum": ["100m", "250m", "500m", "1"] },
        "memory": { "enum": ["128Mi", "256Mi", "512Mi", "1Gi", "2Gi"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minReplicas", "maxReplicas"],
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "oneOf": [
        { "properties": { "minReplicas": { "const": 1 }, "maxReplicas": { "enum": [1, 2, 3, 4, 5] } } },
        { "properties": { "minReplicas": { "const": 2 }, "maxReplicas": { "enum": [2, 3, 4, 5, 10] } } },
        { "properties": { "minReplicas": { "const": 3 }, "maxReplicas": { "enum": [3, 4, 5, 10] } } }
      ]
    },
    "helmAutoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minReplicas", "maxReplicas", "targetCPUUtilization"],
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "targetCPUUtilization": { "type": "integer", "minimum": 40, "maximum": 90 }
      },
      "oneOf": [
        { "properties": { "minReplicas": { "const": 1 }, "maxReplicas": { "enum": [1, 2, 3, 4, 5] } } },
        { "properties": { "minReplicas": { "const": 2 }, "maxReplicas": { "enum": [2, 3, 4, 5, 10] } } },
        { "properties": { "minReplicas": { "const": 3 }, "maxReplicas": { "enum": [3, 4, 5, 10] } } }
      ]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory", "minReplicas", "maxReplicas"],
      "properties": {
        "cpu": { "enum": ["100m", "250m", "500m", "1"] },
        "memory": { "enum": ["128Mi", "256Mi", "512Mi", "1Gi", "2Gi"] },
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "oneOf": [
        { "properties": { "minReplicas": { "const": 1 }, "maxReplicas": { "enum": [1, 2, 3, 4, 5] } } },
        { "properties": { "minReplicas": { "const": 2 }, "maxReplicas": { "enum": [2, 3, 4, 5, 10] } } },
        { "properties": { "minReplicas": { "const": 3 }, "maxReplicas": { "enum": [3, 4, 5, 10] } } }
      ]
    }
  }
}
