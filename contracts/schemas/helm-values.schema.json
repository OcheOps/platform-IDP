{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-idp.dev/schemas/helm-values.schema.json",
  "title": "Shared service Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "image", "deployment", "ingress", "database", "secrets"],
  "properties": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "environment"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/serviceName" },
        "owner": { "$ref": "common.schema.json#/$defs/githubTeam" },
        "environment": { "enum": ["staging", "preview"] }
      }
    },
    "image": { "$ref": "common.schema.json#/$defs/image" },
    "deployment": { "$ref": "#/$defs/deployment" },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname"],
      "properties": { "hostname": { "type": "string", "format": "hostname" } }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine"],
      "properties": {
        "engine": { "enum": ["none", "postgres"] },
        "secretName": { "type": "string", "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$" }
      },
      "allOf": [
        {
          "if": { "properties": { "engine": { "const": "postgres" } }, "required": ["engine"] },
          "then": { "required": ["secretName"] },
          "else": { "not": { "required": ["secretName"] } }
        }
      ]
    },
    "secrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environmentVariable", "secretName", "key"],
        "properties": {
          "environmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "secretName": { "type": "string", "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$" },
          "key": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "health", "resources", "autoscaling"],
      "properties": {
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["livePath", "readyPath"],
          "properties": {
            "livePath": { "type": "string", "pattern": "^/" },
            "readyPath": { "type": "string", "pattern": "^/" }
          }
        },
        "resources": { "$ref": "common.schema.json#/$defs/resources" },
        "autoscaling": { "$ref": "common.schema.json#/$defs/helmAutoscaling" },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        }
      }
    }
  }
}
