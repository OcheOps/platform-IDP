{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-idp.dev/schemas/service-request.schema.json",
  "title": "Service request",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.idp/v1alpha1" },
    "kind": { "const": "ServiceRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "requester", "requestId"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/serviceName" },
        "owner": { "$ref": "common.schema.json#/$defs/githubTeam" },
        "requester": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "requestId": { "type": "string", "format": "uuid" },
        "description": { "type": "string", "maxLength": 280 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "environment", "capacity", "database"],
      "properties": {
        "template": { "$ref": "common.schema.json#/$defs/template" },
        "environment": { "const": "staging" },
        "capacity": { "$ref": "common.schema.json#/$defs/capacity" },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine"],
          "properties": {
            "engine": { "enum": ["none", "postgres"] }
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "ttlHours": { "type": "integer", "minimum": 1, "maximum": 168, "default": 72 }
          }
        }
      }
    }
  }
}
