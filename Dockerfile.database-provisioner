FROM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/database-provisioner ./cmd/database-provisioner
COPY internal/databaseworker ./internal/databaseworker
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/database-provisioner ./cmd/database-provisioner

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/database-provisioner /usr/local/bin/database-provisioner
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/database-provisioner"]
